    await sleep(800);
    path = location.pathname.toLowerCase();
  }

  const composerBar = [...document.querySelectorAll('button, [role="button"]')]
    .map((node) => ({ node, rect: node.getBoundingClientRect?.(), text: textOf(node) }))
