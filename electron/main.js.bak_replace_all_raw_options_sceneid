  if (!Array.isArray(parsed.beats) || parsed.beats.length === 0) {
    throw new Error('Model không trả về beats hợp lệ.');
  }

  return parsed.beats.slice(0, Number(totalSegments)).map((beat, index) => ({
    title: String(beat.title || `Scene ${index + 1}`),
