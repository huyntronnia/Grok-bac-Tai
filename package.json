{
  "name": "vidora",
  "version": "1.0.0",
  "description": "Vidora desktop workflow app for AI video scene batching, prompt review, keyframe generation, and Grok video automation.",
  "main": "electron/main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "test": "node -r ./tests/normalize-hook.js tests/partial-mode-cleanup.test.js && node -r ./tests/normalize-hook.js tests/pipeline-stop-cancellation.test.js && node -r ./tests/normalize-hook.js tests/veoup-output-lifecycle.test.js && node -r ./tests/normalize-hook.js tests/chatgpt-stage-isolation.test.js",
    "dist": "electron-builder --win nsis --x64"
  },
  "keywords": [
    "electron",
    "vidora",
    "ai-video",
    "video-automation"
  ],
  "author": "",
  "license": "MIT",
  "build": {
    "appId": "com.vidora.desktop",
    "productName": "Vidora",
    "directories": {
      "output": "dist"
    },
    "files": [
      "electron/**/*",
      "package.json",
      "node_modules/**/*"
    ],
    "asarUnpack": [
      "node_modules/ffmpeg-static/**/*"
    ],
    "extraResources": [
      {
        "from": "2 NHIỆM VỤ BẰNG PROMPT.txt",
        "to": "prompts/2 NHIỆM VỤ BẰNG PROMPT.txt"
      },
      {
        "from": "node_modules/ffmpeg-static/ffmpeg.exe",
        "to": "ffmpeg.exe"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Vidora"
    }
  },
  "devDependencies": {
    "electron": "^30.5.1",
    "electron-builder": "^26.8.1"
  },
  "dependencies": {
    "ffmpeg-static": "^5.3.0",
    "playwright": "^1.61.1",
    "playwright-core": "^1.61.1"
  }
}
